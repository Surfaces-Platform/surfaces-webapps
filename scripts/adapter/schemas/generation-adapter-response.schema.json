{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaces.dev/schemas/generation-adapter-response.schema.json",
  "title": "GenerationAdapterResponse",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "requestId",
    "status",
    "surfaceId",
    "contract",
    "coverage",
    "findings",
    "timings"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "warn", "block"]
    },
    "surfaceId": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationGuard", "fullValidate"],
      "properties": {
        "generationGuard": {
          "type": "boolean"
        },
        "fullValidate": {
          "type": "boolean"
        },
        "shellBoundaryEvaluated": {
          "type": "boolean"
        },
        "colorPolicyEvaluated": {
          "type": "boolean"
        },
        "iconPolicyEvaluated": {
          "type": "boolean"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalMs"],
      "properties": {
        "totalMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "severity", "policy", "message", "location", "evidence"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning"]
        },
        "policy": {
          "type": "string",
          "enum": ["strict", "warn", "off"]
        },
        "message": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line"],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidence": {
          "type": "object"
        }
      }
    }
  }
}
