{
  "name": "surfaces-web-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "validate:contract": "./scripts/validate-contract.sh",
    "validate:contract:text": "node /Users/mike/Cursor/interfacectl/packages/interfacectl-cli/dist/index.js validate --root . --contract ./contracts/surfaces.web.contract.json --format text",
    "validate:contract:dev": "cd /Users/mike/Cursor/interfacectl && pnpm run build && cd - && ./scripts/validate-contract.sh",
    "dev:surfaces": "pnpm --filter surfaces-web dev",
    "dev:surfaceops": "pnpm --filter surfaceops-web dev",
    "dev:interfacectl": "pnpm --filter interfacectl-web dev",
    "dev:all": "pnpm --filter surfaces-web dev & pnpm --filter surfaceops-web dev & pnpm --filter interfacectl-web dev",
    "type-check": "pnpm --filter @surfaces/ui type-check && pnpm --filter surfaces-web type-check && pnpm --filter surfaceops-web type-check && pnpm --filter interfacectl-web type-check",
    "type-check:ui": "pnpm --filter @surfaces/ui type-check",
    "type-check:surfaces": "pnpm --filter surfaces-web type-check",
    "type-check:surfaceops": "pnpm --filter surfaceops-web type-check",
    "type-check:interfacectl": "pnpm --filter interfacectl-web type-check"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
  "dependencies": {
    "motion": "^12.24.7"
  }
}
