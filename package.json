{
  "name": "surfaces-web-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "interfacectl:build": "node scripts/interfacectl-tool.mjs build",
    "interfacectl:bin": "node scripts/interfacectl-tool.mjs path cli",
    "validate:contract": "./scripts/validate-contract.sh",
    "vercel:check": "./scripts/check-vercel-deployments.sh",
    "vercel:monitor": "./scripts/monitor-vercel.sh",
    "vercel:project:check": "node scripts/vercel/safe-cli.mjs check",
    "vercel:project:audit": "node scripts/vercel/safe-cli.mjs audit",
    "vercel:project:link": "node scripts/vercel/safe-cli.mjs link",
    "vercel:env:pull": "node scripts/vercel/safe-cli.mjs env-pull",
    "vercel:integration:list": "node scripts/vercel/safe-cli.mjs integration-list",
    "vercel:integration:add": "node scripts/vercel/safe-cli.mjs integration-add",
    "monitor:commit-redeploy": "./scripts/monitor-commit-redeploy.sh",
    "adapter:validate-generation": "node scripts/adapter/validate-generation.mjs",
    "adapter:validate-generation:example": "node scripts/adapter/validate-generation.mjs --tool codex --surface surfaces-web --mode workspace --workspace-root . --contract ./contracts/surfaces.web.contract.json",
    "adapter:serve-generation": "node scripts/adapter/serve-generation-adapter.mjs --contract ./contracts/surfaces.web.contract.json",
    "generate:contract": "node scripts/interfacectl-tool.mjs run cli generate-contract --app-root apps/surfaces-web --surface surfaces-web --out contracts/generated/surfaces-web.contract.json --report-out contracts/generated/surfaces-web.extraction.json && pnpm run generate:runtime-manifest",
    "generate:runtime-manifest": "node scripts/generate-runtime-manifest.mjs --surface surfaces-web --out contracts/generated/surfaces-web.runtime-manifest.json",
    "generate:contract:all": "./scripts/generate-all-contracts.sh",
    "validate:repo-style": "node scripts/check-elevated-cards.mjs --workspace-root . --contract ./contracts/surfaces.web.contract.json --config ./interfacectl.config.json",
    "validate:contract:json": "node scripts/interfacectl-tool.mjs run cli validate --workspace-root . --contract ./contracts/surfaces.web.contract.json --format json --out ./artifacts/interfacectl-report.json",
    "validate:contract:text": "node scripts/interfacectl-tool.mjs run cli validate --root . --contract ./contracts/surfaces.web.contract.json --format text",
    "validate:contract:dev": "pnpm run interfacectl:build && ./scripts/validate-contract.sh",
    "validate:local": "node scripts/interfacectl-tool.mjs run cli validate --workspace-root . --contract ./contracts/surfaces.web.contract.json && pnpm run validate:repo-style",
    "validate:ci": "pnpm run interfacectl:build && node scripts/print-provenance.mjs && node scripts/interfacectl-tool.mjs run cli validate --workspace-root . --contract ./contracts/surfaces.web.contract.json && pnpm run validate:repo-style",
    "validate:extracted": "node scripts/interfacectl-tool.mjs run cli validate-extracted --contract ./contracts/surfaces.web.contract.json --extracted ./contracts/generated/surfaces-web.extraction.json --surface surfaces-web --exit-codes v2",
    "validate:docs-ownership": "node scripts/check-docs-ownership.mjs",
    "validate:run-artifacts": "node scripts/validate-run-artifacts.mjs",
    "check:promotion-readiness": "node scripts/check-promotion-readiness.mjs --mode advisory --output artifacts/promotion-readiness.json",
    "demo:bootstrap": "./scripts/demos/demo-bootstrap-contract.sh",
    "demo:bootstrap:promote": "PROMOTE_BOOTSTRAP=1 ./scripts/demos/demo-bootstrap-contract.sh --promote",
    "demo:generation": "./scripts/demos/demo-generation.sh",
    "demo:ci:surfaceops": "./scripts/demos/demo-ci-surfaceops.sh",
    "demo:runtime:surfaceops": "./scripts/demos/demo-runtime-surfaceops.sh",
    "surfaceops:sync-run-artifacts:db": "pnpm --filter surfaceops-web sync:run-artifacts:db",
    "pilot:icons:reference-target": "node ./scripts/verify-icon-strict-pilot.mjs",
    "demo:governance:inspector": "node ./scripts/demos/demo-governance-inspector.mjs",
    "demo:governance:inspector:narrated": "node ./scripts/demos/demo-governance-inspector.mjs --narrated --slow-mo 350",
    "demo:governance:inspector:narrated:record": "node ./scripts/demos/demo-governance-inspector.mjs --narrated --record --slow-mo 350",
    "demo:all:visual": "pnpm run demo:bootstrap:promote && pnpm run demo:generation && pnpm run demo:ci:surfaceops && pnpm run demo:runtime:surfaceops",
    "prototype:governance:new": "node scripts/prototypes/new-governance-prototype.mjs",
    "prototype:governance:snapshot": "node scripts/prototypes/snapshot-governance-extraction.mjs",
    "examples:build-manifest": "node docs/demos/runtime-edge/build-manifest.mjs",
    "examples:test-edge": "node docs/demos/runtime-edge/test-edge.mjs",
    "cli:where:local": "node scripts/interfacectl-tool.mjs inspect cli",
    "cli:where:ci": "node scripts/interfacectl-tool.mjs inspect all",
    "dev:surfaces": "pnpm --filter surfaces-web dev",
    "dev:surfaceops": "pnpm --filter surfaceops-web dev",
    "dev:interfacectl": "pnpm --filter interfacectl-web dev",
    "dev:surfaces-dev": "pnpm --filter surfaces-dev dev",
    "dev:reference-target": "pnpm --filter reference-target-web dev",
    "dev:all": "pnpm --filter surfaces-web dev & pnpm --filter surfaceops-web dev & pnpm --filter interfacectl-web dev & pnpm --filter surfaces-dev dev & pnpm --filter reference-target-web dev",
    "setup:auth": "./scripts/setup-auth.sh",
    "type-check": "pnpm --filter @surfaces/ui type-check && pnpm --filter surfaces-web type-check && pnpm --filter surfaceops-web type-check && pnpm --filter interfacectl-web type-check && pnpm --filter surfaces-dev type-check && pnpm --filter reference-target-web type-check",
    "type-check:ui": "pnpm --filter @surfaces/ui type-check",
    "type-check:surfaces": "pnpm --filter surfaces-web type-check",
    "type-check:surfaceops": "pnpm --filter surfaceops-web type-check",
    "type-check:interfacectl": "pnpm --filter interfacectl-web type-check",
    "type-check:surfaces-dev": "pnpm --filter surfaces-dev type-check",
    "type-check:reference-target": "pnpm --filter reference-target-web type-check",
    "test:scripts": "node --test scripts/__tests__/vercel-monitoring.test.mjs scripts/__tests__/vercel-project-guard.test.mjs scripts/__tests__/demo-scripts.test.mjs scripts/__tests__/icon-pilot.test.mjs scripts/__tests__/run-artifacts.test.mjs scripts/__tests__/contract-runs-writer.test.mjs scripts/__tests__/check-promotion-readiness.test.mjs scripts/__tests__/governance-prototype-snapshot.test.mjs scripts/__tests__/generation-adapter.test.mjs scripts/__tests__/interfacectl-tooling.test.mjs scripts/__tests__/print-provenance.test.mjs scripts/__tests__/elevated-card-policy.test.mjs scripts/__tests__/docs-ownership.test.mjs",
    "test:onboarding:smoke:headless": "node --test scripts/__tests__/onboarding-smoke.test.mjs",
    "test:onboarding:smoke:browser": "node --test apps/surfaceops-web/tests/onboarding-browser-smoke.test.mjs",
    "test:onboarding:smoke": "pnpm run test:onboarding:smoke:headless && pnpm run test:onboarding:smoke:browser",
    "test:platform-e2e": "node --test scripts/__tests__/platform-enforcement-e2e.test.mjs",
    "test": "pnpm --filter surfaceops-web test && pnpm run test:scripts"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^20.14.9",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
  "dependencies": {
    "motion": "^12.24.7"
  }
}
