{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "surface",
    "version",
    "layout",
    "navigation",
    "generation",
    "drift"
  ],
  "properties": {
    "surface": {
      "type": "string",
      "enum": ["marketing", "app", "admin", "cli"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "layout": {
      "type": "object",
      "required": [
        "allowedPatterns",
        "maxContentWidth",
        "requireGlobalHeader",
        "requirePageContainer"
      ],
      "properties": {
        "allowedPatterns": {
          "type": "object",
          "required": [
            "singleColumn",
            "sidebarContent",
            "dashboardGrid",
            "wizardFlow"
          ],
          "properties": {
            "singleColumn": { "$ref": "#/$defs/ruleLevel" },
            "sidebarContent": { "$ref": "#/$defs/ruleLevel" },
            "dashboardGrid": { "$ref": "#/$defs/ruleLevel" },
            "wizardFlow": { "$ref": "#/$defs/ruleLevel" }
          },
          "additionalProperties": false
        },
        "maxContentWidth": {
          "type": "number",
          "minimum": 320,
          "maximum": 2400
        },
        "requireGlobalHeader": { "type": "boolean" },
        "requirePageContainer": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "required": [
        "types",
        "maxDepth",
        "disallowDuplicateNavigation",
        "requireSinglePrimaryNav"
      ],
      "properties": {
        "types": {
          "type": "object",
          "required": ["topNav", "sideNav", "tabs"],
          "properties": {
            "topNav": { "$ref": "#/$defs/ruleLevel" },
            "sideNav": { "$ref": "#/$defs/ruleLevel" },
            "tabs": { "$ref": "#/$defs/ruleLevel" }
          },
          "additionalProperties": false
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "disallowDuplicateNavigation": { "type": "boolean" },
        "requireSinglePrimaryNav": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": [
        "mustUseDesignTokens",
        "forbidNewLayoutPrimitives",
        "forbidAdditionalNavLayer",
        "structuralChangesRequireReview",
        "autoCorrectMinorDeviation"
      ],
      "properties": {
        "mustUseDesignTokens": { "type": "boolean" },
        "forbidNewLayoutPrimitives": { "type": "boolean" },
        "forbidAdditionalNavLayer": { "type": "boolean" },
        "structuralChangesRequireReview": { "type": "boolean" },
        "autoCorrectMinorDeviation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "drift": {
      "type": "object",
      "required": ["detectionMode", "severityThreshold", "autoFixPolicy"],
      "properties": {
        "detectionMode": {
          "type": "string",
          "enum": ["onCommit", "onBuild"]
        },
        "severityThreshold": {
          "type": "string",
          "enum": ["informational", "warning", "blocking"]
        },
        "autoFixPolicy": {
          "type": "string",
          "enum": ["never", "safeOnly"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ruleLevel": {
      "type": "string",
      "enum": ["required", "allowed", "forbidden"]
    }
  }
}
