{
  "name": "surfaceops-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001 --webpack",
    "dev:rehearsal-feed": "SURFACEOPS_DESKTOP_RELEASE_MANIFEST_URL=https://github.com/Surfaces-Platform/surfaces-webapps/releases/download/surfaceops-desktop-feed-rehearsal/surfaceops-desktop-release-manifest.json next dev --port 3001 --webpack",
    "dev:unsigned-rehearsal-feed": "node scripts/dev-unsigned-rehearsal-feed.mjs",
    "dev:local-workbench": "node scripts/dev-local-workbench.mjs",
    "prebuild": "pnpm --filter @surfaces/platform-auth build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:fixture": "tsx scripts/run-generation-benchmark.ts",
    "benchmark:reference-target-web": "tsx scripts/run-reference-target-benchmark.ts",
    "migrate": "tsx scripts/run-migrations.ts",
    "sync:run-artifacts:db": "tsx scripts/sync-run-artifacts-to-db.ts"
  },
  "dependencies": {
    "@surfaces/surfaceops-desktop-bridge": "workspace:*",
    "@surfaces/platform-auth": "workspace:*",
    "@surfaces/ui": "workspace:*",
    "motion": "^12.23.24",
    "next": "16.1.1",
    "pg": "^8.13.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
