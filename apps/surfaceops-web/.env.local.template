# Copy to .env.local. Values from scratch/secrets/*.txt (see docs/platform-auth/local-setup.md)
# PORT 3001 | PLATFORM_SURFACE_ID surfaceops.ai

PLATFORM_SURFACE_ID=surfaceops.ai
OIDC_ISSUER=REPLACE_ME
# ^ from scratch/secrets/OIDC_ISSUER.txt
OIDC_CLIENT_ID=REPLACE_ME
# ^ from scratch/secrets/OIDC_CLIENT_ID.txt
OIDC_CLIENT_SECRET=REPLACE_ME
# ^ from scratch/secrets/OIDC_CLIENT_SECRET.txt
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/
OIDC_LOGOUT_URL=https://surfaces.us.auth0.com/v2/logout
SESSION_SECRET=REPLACE_ME
# ^ from scratch/secrets/SESSION_SECRET.txt
OIDC_WORKSPACE_CLAIM=https://surfaces.systems/workspace_id
OIDC_SURFACE_ACCESS_CLAIM=https://surfaces.systems/surface_access
