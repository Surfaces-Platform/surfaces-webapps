{
  "$schema": "https://contracts.surfaces.local/web.surface.contract.schema.json",
  "color": {
    "allowedValues": [
      "#f9fbff",
      "#fdfefe",
      "rgba(255, 255, 255, 0.94)",
      "var(--bg)",
      "var(--muted)",
      "var(--surface)",
      "var(--text)"
    ],
    "policy": "warn"
  },
  "constraints": {
    "motion": {
      "allowedDurationsMs": [
        120
      ],
      "allowedTimingFunctions": [
        "linear"
      ]
    }
  },
  "contractId": "reference-target-web.generated",
  "description": "Generated from the reference target fixture and curated for deterministic workspace validation.",
  "sections": [
    {
      "description": "Hero introduction for the deterministic reference target fixture.",
      "id": "landing.hero",
      "intent": "hero"
    },
    {
      "description": "Capability grid that groups the reference target cards.",
      "id": "landing.capabilities",
      "intent": "feature-grid"
    },
    {
      "description": "Contract validation summary card within the capabilities grid.",
      "id": "landing.contracts",
      "intent": "contract-summary"
    },
    {
      "description": "Token baseline card describing the design-token path.",
      "id": "landing.tokens",
      "intent": "token-summary"
    },
    {
      "description": "Observability card describing deterministic simulation behaviors.",
      "id": "landing.observability",
      "intent": "observability-summary"
    },
    {
      "description": "Optional destructive action simulation card for guard validation.",
      "id": "landing.actions",
      "intent": "destructive-action"
    }
  ],
  "surfaces": [
    {
      "allowedFonts": [
        "Inter",
        "sans-serif",
        "var(--font-inter)"
      ],
      "displayName": "Reference Target Web",
      "icons": {
        "allowedSources": [],
        "policy": "warn"
      },
      "id": "reference-target-web",
      "layout": {
        "chromePolicy": {
          "allowInsetShadow": false,
          "allowOuterShadow": false,
          "maxBorderRadiusPx": 0,
          "policy": "off",
          "targets": [
            "layout-container",
            "page-container",
            "top-level-section"
          ]
        },
        "maxContentWidth": 1160,
        "requiredContainers": [
          "page-container"
        ],
        "targetAcquisition": {
          "destructiveGapPx": 16,
          "minEdgeInsetPx": 8,
          "minGapPx": 8,
          "minHitAreaPx": 44,
          "modality": "touch-mouse",
          "policy": "warn"
        }
      },
      "phase0": {
        "authPosture": "public",
        "requiresShell": true
      },
      "requiredSections": [
        "landing.hero",
        "landing.capabilities",
        "landing.contracts",
        "landing.tokens",
        "landing.observability",
        "landing.actions"
      ],
      "type": "web"
    }
  ],
  "tokens": {
    "layout": {
      "allowedTokens": [
        "var(--contract-max-width)"
      ],
      "policy": "warn",
      "tokenMetadata": [
        {
          "aliases": [],
          "attributes": [
            "max-width"
          ],
          "normalizedValue": "1160px",
          "token": "var(--contract-max-width)"
        }
      ]
    },
    "motion": {
      "allowedTokens": [],
      "policy": "warn"
    },
    "typography": {
      "allowedTokens": [
        "var(--font-inter)"
      ],
      "policy": "warn",
      "tokenMetadata": [
        {
          "aliases": [],
          "attributes": [
            "font-family"
          ],
          "normalizedValue": "var(--font-inter)",
          "token": "var(--font-inter)"
        }
      ]
    }
  },
  "version": "0.1.0",
  "x_extracted": {
    "authAware": false,
    "designSystemComponents": [],
    "hasShell": true,
    "routes": [
      "/",
      "/adaptive/[...slug]"
    ]
  }
}
