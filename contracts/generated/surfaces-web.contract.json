{
  "$schema": "https://contracts.surfaces.local/web.surface.contract.schema.json",
  "color": {
    "allowedValues": [
      "#0f172a",
      "#334155",
      "#475569",
      "#64748b",
      "#94a3b8",
      "#e2e8f0",
      "#ffffff",
      "rgba(255, 255, 255, 0.8)",
      "var(--background)",
      "var(--foreground)"
    ],
    "policy": "warn"
  },
  "constraints": {
    "motion": {
      "allowedDurationsMs": [
        120
      ],
      "allowedTimingFunctions": [
        "linear"
      ]
    }
  },
  "contractId": "surfaces-web.generated",
  "description": "Extracted from Next.js app (Phase 0).",
  "sections": [
    {
      "description": "Placeholder; sections not extracted in Phase 0.",
      "id": "extracted.placeholder",
      "intent": "extracted"
    }
  ],
  "surfaces": [
    {
      "allowedFonts": [
        "sans-serif"
      ],
      "displayName": "Surfaces Web",
      "icons": {
        "allowedSources": [
          "@heroicons/react/24/outline"
        ],
        "policy": "warn"
      },
      "id": "surfaces-web",
      "layout": {
        "chromePolicy": {
          "allowInsetShadow": true,
          "allowOuterShadow": false,
          "maxBorderRadiusPx": 8,
          "policy": "off",
          "targets": [
            "page-container",
            "top-level-section",
            "layout-container"
          ]
        },
        "maxContentWidth": 1120
      },
      "requiredSections": [
        "extracted.placeholder"
      ],
      "type": "web"
    }
  ],
  "version": "0.1.0",
  "x_extracted": {
    "authAware": true,
    "designSystemComponents": [
      "Navigation"
    ],
    "hasShell": true,
    "routes": [
      "/",
      "/adaptive/[...slug]",
      "/auth/callback",
      "/auth/login",
      "/auth/logout",
      "/auth/session",
      "/demos/ci",
      "/demos/generation"
    ]
  }
}
