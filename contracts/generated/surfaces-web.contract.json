{
  "$schema": "https://contracts.surfaces.local/web.surface.contract.schema.json",
  "color": {
    "allowedValues": [
      "var(--background)",
      "var(--foreground)",
      "var(--sp-color-ash)",
      "var(--sp-color-graphite)",
      "var(--sp-color-ink)",
      "var(--sp-color-line)",
      "var(--sp-color-mist)",
      "var(--sp-color-paper)",
      "var(--sp-color-steel)",
      "var(--sp-color-white)",
      "var(--sp-ui-danger-bg)",
      "var(--sp-ui-danger-text)",
      "var(--sp-ui-info-bg)",
      "var(--sp-ui-info-text)",
      "var(--sp-ui-success-bg)",
      "var(--sp-ui-success-text)",
      "var(--sp-ui-warning-bg)",
      "var(--sp-ui-warning-text)"
    ],
    "policy": "warn"
  },
  "constraints": {
    "motion": {
      "allowedDurationsMs": [
        120
      ],
      "allowedTimingFunctions": [
        "linear"
      ]
    }
  },
  "contractId": "surfaces-web.generated",
  "description": "Extracted from Next.js app (Phase 0).",
  "sections": [
    {
      "description": "Placeholder; sections not extracted in Phase 0.",
      "id": "extracted.placeholder",
      "intent": "extracted"
    }
  ],
  "surfaces": [
    {
      "allowedFonts": [
        "Arial",
        "Helvetica",
        "Inter",
        "sans-serif",
        "var(--font-inter)"
      ],
      "displayName": "Surfaces Web",
      "icons": {
        "allowedSources": [
          "@heroicons/react/24/outline"
        ],
        "policy": "warn"
      },
      "id": "surfaces-web",
      "layout": {
        "chromePolicy": {
          "allowInsetShadow": false,
          "allowOuterShadow": false,
          "maxBorderRadiusPx": 0,
          "policy": "off",
          "targets": [
            "layout-container",
            "page-container",
            "top-level-section"
          ]
        },
        "maxContentWidth": 1120
      },
      "requiredSections": [
        "extracted.placeholder"
      ],
      "type": "web"
    }
  ],
  "tokens": {
    "layout": {
      "allowedTokens": [
        "var(--contract-max-width)",
        "var(--sp-radius-lg)",
        "var(--sp-radius-md)",
        "var(--sp-radius-sm)"
      ],
      "policy": "warn",
      "tokenMetadata": [
        {
          "aliases": [],
          "attributes": [
            "width"
          ],
          "normalizedValue": "1120px",
          "token": "var(--contract-max-width)"
        },
        {
          "aliases": [],
          "attributes": [
            "border-radius"
          ],
          "normalizedValue": "8px",
          "token": "var(--sp-radius-lg)"
        },
        {
          "aliases": [],
          "attributes": [
            "border-radius"
          ],
          "normalizedValue": "6px",
          "token": "var(--sp-radius-md)"
        },
        {
          "aliases": [],
          "attributes": [
            "border-radius"
          ],
          "normalizedValue": "4px",
          "token": "var(--sp-radius-sm)"
        }
      ]
    },
    "motion": {
      "allowedTokens": [
        "var(--contract-motion-duration)",
        "var(--contract-motion-timing)"
      ],
      "policy": "warn",
      "tokenMetadata": [
        {
          "aliases": [],
          "attributes": [
            "transition"
          ],
          "normalizedValue": "120ms",
          "token": "var(--contract-motion-duration)"
        },
        {
          "aliases": [],
          "attributes": [
            "transition"
          ],
          "normalizedValue": "linear",
          "token": "var(--contract-motion-timing)"
        }
      ]
    },
    "typography": {
      "allowedTokens": [
        "var(--font-inter)"
      ],
      "policy": "warn",
      "tokenMetadata": [
        {
          "aliases": [],
          "attributes": [
            "font-family"
          ],
          "normalizedValue": "inter, sans-serif",
          "token": "var(--font-inter)"
        }
      ]
    }
  },
  "version": "0.1.0",
  "x_extracted": {
    "authAware": true,
    "designSystemComponents": [
      "Navigation"
    ],
    "hasShell": true,
    "routes": [
      "/",
      "/adaptive/[...slug]",
      "/api/invite-request",
      "/auth/callback",
      "/auth/login",
      "/auth/logout",
      "/auth/session",
      "/demos/ci",
      "/demos/generation",
      "/design-system",
      "/design-system/[section]"
    ]
  }
}
