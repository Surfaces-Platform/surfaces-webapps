{
  "$schema": "./surfaces.web.contract.schema.json",
  "contractId": "surfaces.web",
  "version": "0.1.0",
  "description": "Interface expectations shared across InterfaceCTL, SurfaceOps, and Surfaces web experiences.",
  "surfaces": [
    {
      "id": "interfacectl-web",
      "displayName": "InterfaceCTL Web",
      "type": "web",
      "requiredSections": [
        "landing.hero",
        "landing.guidance",
        "landing.actions"
      ],
      "allowedFonts": [
        "var(--font-geist-mono)",
        "JetBrains Mono",
        "monospace",
        "var(--font-geist-sans)",
        "Arial",
        "Helvetica",
        "sans-serif"
      ],
      "allowedColors": [
        "var(--background)",
        "var(--foreground)",
        "var(--color-background)",
        "var(--color-foreground)",
        "var(--surface)",
        "var(--contrast)",
        "#171717",
        "#FFFFFF",
        "#000000",
        "rgba(17, 24, 39, 0.08)"
      ],
      "layout": {
        "maxContentWidth": 1120
      }
    },
    {
      "id": "surfaceops-web",
      "displayName": "SurfaceOps Web",
      "type": "web",
      "requiredSections": [
        "landing.hero",
        "landing.guidance",
        "landing.actions"
      ],
      "allowedFonts": [
        "var(--font-geist-sans)",
        "var(--font-inter)",
        "Inter",
        "var(--font-geist-mono)",
        "Arial",
        "Helvetica",
        "sans-serif"
      ],
      "allowedColors": [
        "var(--background)",
        "var(--foreground)",
        "var(--color-background)",
        "var(--color-foreground)",
        "#FAFAFA",
        "#fafafa",
        "#171717",
        "rgba(15, 23, 42, 0.3)",
        "rgba(94, 234, 212, 0.1)",
        "rgba(2, 132, 199, 0.2)",
        "rgba(56, 189, 248, 0.9)"
      ],
      "layout": {
        "maxContentWidth": 1120
      }
    },
    {
      "id": "surfaces-web",
      "displayName": "Surfaces Web",
      "type": "web",
      "requiredSections": [
        "landing.hero",
        "landing.guidance",
        "landing.actions"
      ],
      "allowedFonts": [
        "var(--font-geist-sans)",
        "var(--font-inter)",
        "Inter",
        "var(--font-geist-mono)",
        "Arial",
        "Helvetica",
        "sans-serif"
      ],
      "allowedColors": [
        "var(--background)",
        "var(--foreground)",
        "var(--color-background)",
        "var(--color-foreground)",
        "#FAFAFA",
        "#fafafa",
        "#171717",
        "rgba(255, 255, 255, 0.8)",
        "rgba(99, 102, 241, 0.15)",
        "rgba(99, 102, 241, 0.4)"
      ],
      "layout": {
        "maxContentWidth": 1120
      }
    }
  ],
  "sections": [
    {
      "id": "landing.hero",
      "intent": "primary-intro",
      "description": "Primary hero section introducing the surface intent."
    },
    {
      "id": "landing.guidance",
      "intent": "supporting-guidance",
      "description": "Supplemental copy guiding users to next actions."
    },
    {
      "id": "landing.actions",
      "intent": "primary-actions",
      "description": "Primary calls-to-action for the surface."
    }
  ],
  "constraints": {
    "motion": {
      "allowedDurationsMs": [
        120
      ],
      "allowedTimingFunctions": [
        "linear"
      ]
    }
  }
}
