{
  "$schema": "./web.surface.contract.schema.json",
  "contractId": "surfaces.web",
  "version": "0.1.0",
  "description": "Interface expectations shared across InterfaceCTL, SurfaceOps, and Surfaces web experiences.",
  "surfaces": [
    {
      "id": "interfacectl-web",
      "displayName": "InterfaceCTL Web",
      "type": "web",
      "requiredSections": [
        "landing.hero",
        "landing.guidance",
        "landing.actions"
      ],
      "allowedFonts": [
        "var(--font-geist-mono)",
        "JetBrains Mono",
        "monospace",
        "var(--font-geist-sans)",
        "Arial",
        "Helvetica",
        "sans-serif"
      ],
      "layout": {
        "maxContentWidth": 1120
      },
      "domain": "www.interfacectl.com",
      "phase0": {
        "authPosture": "auth-aware",
        "requiresShell": true,
        "expectsAuthRoutes": true,
        "expectsDesignSystem": true
      },
      "owner": ""
    },
    {
      "id": "surfaceops-web",
      "displayName": "SurfaceOps Web",
      "type": "web",
      "requiredSections": [
        "landing.hero",
        "landing.guidance",
        "landing.actions"
      ],
      "allowedFonts": [
        "var(--font-geist-sans)",
        "var(--font-inter)",
        "Inter",
        "var(--font-geist-mono)",
        "Arial",
        "Helvetica",
        "sans-serif"
      ],
      "layout": {
        "maxContentWidth": 1120
      },
      "domain": "www.surfaceops.ai",
      "phase0": {
        "authPosture": "auth-aware",
        "requiresShell": true,
        "expectsAuthRoutes": true,
        "expectsDesignSystem": true
      },
      "owner": "",
      "mustNotEmit": [
        "navigation",
        "footer",
        "auth-shell"
      ],
      "shellOwnedPrimitiveAllowSources": [
        "apps/surfaceops-web/app/layout.tsx"
      ]
    },
    {
      "id": "surfaces-web",
    "displayName": "Surfaces Web",
    "type": "web",
    "requiredSections": [
      "landing.hero",
      "landing.demos",
      "landing.guidance",
      "landing.actions"
    ],
      "allowedFonts": [
        "var(--font-geist-sans)",
        "var(--font-inter)",
        "Inter",
        "var(--font-geist-mono)",
        "Arial",
        "Helvetica",
        "sans-serif"
      ],
      "layout": {
        "maxContentWidth": 1120
      },
      "domain": "www.surfaces.systems",
      "phase0": {
        "authPosture": "auth-aware",
        "requiresShell": true,
        "expectsAuthRoutes": true,
        "expectsDesignSystem": true
      },
      "owner": ""
    },
    {
      "id": "surfaces-dev",
      "displayName": "Surfaces Dev",
      "type": "web",
      "requiredSections": [
        "landing.hero",
        "landing.actions"
      ],
      "allowedFonts": [
        "var(--font-geist-mono)",
        "JetBrains Mono",
        "monospace",
        "var(--font-geist-sans)",
        "Arial",
        "Helvetica",
        "sans-serif"
      ],
      "layout": {
        "maxContentWidth": 1120
      },
      "domain": "www.surfaces.dev",
      "phase0": {
        "authPosture": "auth-aware",
        "requiresShell": true,
        "expectsAuthRoutes": true,
        "expectsDesignSystem": true
      },
      "owner": ""
    }
  ],
  "sections": [
  {
    "id": "landing.hero",
    "intent": "primary-intro",
    "description": "Primary hero section introducing the surface intent."
  },
  {
    "id": "landing.demos",
    "intent": "enforcement-demos",
    "description": "Links to generation-time, CI/CD, and adaptive runtime enforcement demos."
  },
  {
    "id": "landing.guidance",
    "intent": "supporting-guidance",
    "description": "Supplemental copy guiding users to next actions."
  },
    {
      "id": "landing.actions",
      "intent": "primary-actions",
      "description": "Primary calls-to-action for the surface."
    }
  ],
  "constraints": {
    "motion": {
      "allowedDurationsMs": [
        120
      ],
      "allowedTimingFunctions": [
        "linear"
      ]
    }
  }
}
