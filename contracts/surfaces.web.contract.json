            "top-level-section",
            "layout-container"
          ]
        },
        "landingPattern": {
          "marketingLayoutPolicy": "warn",
          "marketingLayoutProfile": "marketing-open-flow-text-compact",
          "pageBackgroundMode": "solid",
          "policy": "strict",
          "requireTopLevelSections": [
            "landing.hero",
            "landing.guidance",
            "landing.actions"
          ],
          "sectionOrder": [
            "landing.hero",
            "landing.guidance",
            "landing.actions"
          ]
        },
        "maxContentWidth": 1120
      },
      "marketingTypographyPolicy": "warn",
      "marketingTypographyProfile": "marketing-mono",
      "owner": "",
      "phase0": {
        "authPosture": "auth-aware",
        "expectsAuthRoutes": true,
        "expectsDesignSystem": true,
        "requiresShell": true
      },
      "requiredSections": [
        "landing.hero",
        "landing.guidance",
        "landing.actions"
      ],
      "type": "web"
    },
