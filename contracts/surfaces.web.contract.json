    {
      "description": "Primary hero section introducing the surface intent.",
      "id": "landing.hero",
      "intent": "primary-intro"
    },
    {
      "description": "Shows the recurring work created when a release decision does not become reusable guidance.",
      "id": "landing.workload",
      "intent": "recurring-review-work"
    },
    {
      "description": "Supplemental copy guiding users to next actions.",
      "id": "landing.guidance",
      "intent": "supporting-guidance"
    },
    {
      "description": "Primary calls-to-action for the surface.",
      "id": "landing.actions",
      "intent": "primary-actions"
    },
    {
      "description": "Desktop rationale and operating-model explanation for SurfaceOps.",
      "id": "landing.whydesktop",
      "intent": "desktop-rationale"
    },
    {
      "description": "Overview of the local SurfaceOps workbench capabilities.",
      "id": "landing.workbench",
      "intent": "workbench-overview"
    },
    {
      "description": "Next-step guidance for installing and following the desktop rollout.",
      "id": "landing.next",
      "intent": "next-steps"
