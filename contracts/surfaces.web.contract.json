        "sectionDividerMode": "border-top",
        "sectionSpacingProfile": "roomy"
      }
    ],
    "typography": [
      {
        "id": "marketing-mono",
        "roles": [
          {
            "allowedTokens": [
              "var(--marketing-mono-hero-eyebrow-family)",
              "var(--marketing-mono-hero-eyebrow-size)",
              "var(--marketing-mono-hero-eyebrow-line-height)",
              "var(--marketing-mono-hero-eyebrow-letter-spacing)"
            ],
            "role": "heroEyebrow"
          },
          {
            "allowedTokens": [
              "var(--marketing-mono-hero-title-family)",
              "var(--marketing-mono-hero-title-size)",
              "var(--marketing-mono-hero-title-line-height)"
            ],
            "role": "heroTitle"
          },
