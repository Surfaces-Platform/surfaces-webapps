    "layout": [
      {
        "heroContainerMode": "open-flow",
        "heroVisualPlacement": "none",
        "id": "marketing-open-flow-text-compact",
        "sectionDividerMode": "border-top",
        "sectionSpacingProfile": "compact"
      },
      {
        "heroContainerMode": "open-flow",
